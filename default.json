{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "extends": [
    "config:recommended",
    "schedule:weekly",
    "group:allNonMajor",
    ":label(dependencies)",
    ":automergeMinor",
    ":disablePeerDependencies",
    ":dependencyDashboard"
  ],
  "branchNameStrict": true
}
